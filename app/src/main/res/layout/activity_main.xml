<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- AppToolbar 컴포넌트 -->
        <com.ssj.statuswindow.ui.components.AppToolbar
            android:id="@+id/appToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 스크롤 가능한 메인 콘텐츠 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 소비 카드 -->
                <com.ssj.statuswindow.ui.components.SummaryCard
                    android:id="@+id/spendingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <!-- 소득 카드 -->
                <com.ssj.statuswindow.ui.components.SummaryCard
                    android:id="@+id/incomeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <!-- 소비 진척도 카드 -->
                <com.ssj.statuswindow.ui.components.ProgressBarCard
                    android:id="@+id/spendingProgressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <!-- 테스트 섹션 헤더 -->
                <com.ssj.statuswindow.ui.components.SectionHeader
                    android:id="@+id/testSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <!-- 테스트 버튼들 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/btnTestCardDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="카드 사용내역" />

                        <Button
                            android:id="@+id/btnTestBankDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="입출금내역" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/btnTestSmsData"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="SMS 테스트" />

                        <Button
                            android:id="@+id/btnTestCardTable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="카드 테이블" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnButtonTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔧 버튼 자동 테스트" />

                    <Button
                        android:id="@+id/btnLogViewer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📝 로그 확인"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnIntegrationTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧪 컴포넌트 검증"
                        android:layout_marginTop="8dp"
                        android:background="#FF9800"
                        android:textColor="@android:color/white" />

                </LinearLayout>

                <!-- 요약 정보 -->
                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 파싱 결과 요약\n\n총 거래: 0건\n카드 거래: 0건\n은행 거래: 0건"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"
                    android:background="#F5F5F5"
                    android:padding="12dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- 네비게이션 드로어 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>