<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingTop="20dp">

    <!-- 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="정렬 기준"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:paddingBottom="20dp" />

    <!-- 정렬 옵션들 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/option_popular"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="인기순"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_check_24dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginHorizontal="24dp" />

        <TextView
            android:id="@+id/option_recent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="최신순"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_check_24dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginHorizontal="24dp" />

        <TextView
            android:id="@+id/option_oldest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="오래된순"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_check_24dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginHorizontal="24dp" />

        <TextView
            android:id="@+id/option_high_amount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="금액 높은순"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_check_24dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginHorizontal="24dp" />

        <TextView
            android:id="@+id/option_low_amount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="금액 낮은순"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_check_24dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5"
            android:layout_marginHorizontal="24dp" />

        <TextView
            android:id="@+id/option_input_order"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="입력순"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableEnd="@drawable/ic_check_24dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 하단 여백 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>
