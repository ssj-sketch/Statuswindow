<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/modification_notification_background"
    android:padding="12dp"
    android:layout_margin="8dp"
    android:visibility="gone"
    android:id="@+id/modificationNotificationLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info_24dp"
            android:layout_marginEnd="8dp"
            android:tint="@color/primary_color" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="수정사항이 있습니다"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvModificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="방금 전"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnCloseNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvModificationDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="상세 수정 내용이 여기에 표시됩니다"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginStart="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp">

        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="자세히 보기"
            android:textSize="12sp"
            android:backgroundTint="@color/primary_color"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnMarkAsRead"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="확인함"
            android:textSize="12sp"
            android:backgroundTint="@color/secondary_color" />

    </LinearLayout>

</LinearLayout>

