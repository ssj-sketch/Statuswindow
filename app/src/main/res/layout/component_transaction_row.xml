<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_xs"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_low"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_lg"
        android:gravity="center_vertical">

        <!-- 아이콘 영역 -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:layout_marginEnd="@dimen/margin_md"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="거래 아이콘" />

        <!-- 메인 정보 영역 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 상호명과 카테고리 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_xs">

                <TextView
                    android:id="@+id/tvMerchant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="상호명"
                    android:textSize="@dimen/text_md"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="카테고리"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/chip_background_neutral"
                    android:padding="@dimen/padding_xs"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 날짜와 메모 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="날짜"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvMemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="메모"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/text_hint"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- 금액 영역 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0원"
                android:textSize="@dimen/text_lg"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="@dimen/margin_xs" />

            <TextView
                android:id="@+id/tvInstallment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일시불"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_hint"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

