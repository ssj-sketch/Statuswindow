<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- AppToolbar 컴포넌트 -->
        <com.ssj.statuswindow.ui.components.AppToolbar
            android:id="@+id/appToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 10월 카드사용내역 타이틀 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳 10월 카드사용내역"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_color"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <!-- 요약 정보 카드 -->
        <com.ssj.statuswindow.ui.components.SummaryCard
            android:id="@+id/summaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 기존 요약 정보 (숨김 처리) -->
        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 카드 사용내역 요약\n\n총 거래: 0건\n총 사용금액: 0원\n총 청구금액: 0원"
            android:textSize="14sp"
            android:layout_margin="16dp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:visibility="gone" />

        <!-- 전체삭제 버튼 (테스트용) -->
        <Button
            android:id="@+id/btnDeleteAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:text="🗑️ 전체삭제 (테스트용)"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/error_color"
            android:textSize="14sp" />

        <!-- 상세 내역 섹션 헤더 -->
        <com.ssj.statuswindow.ui.components.SectionHeader
            android:id="@+id/sectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- 구글 플레이 스타일 정렬 드롭다운 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnSortDropdown"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="인기순"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:background="@drawable/dropdown_button_background"
                android:drawableEnd="@drawable/ic_arrow_drop_down_24dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:minWidth="120dp" />

        </LinearLayout>

        <!-- 거래 내역 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

    <!-- 네비게이션 드로어 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
